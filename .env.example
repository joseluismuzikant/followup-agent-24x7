# Application
APP_ENV=development

# Local Postgres used by Docker Compose
POSTGRES_USER=followup
POSTGRES_PASSWORD=followup
POSTGRES_DB=followup

# API and migrations
DATABASE_URL=postgresql+psycopg://followup:followup@localhost:5433/followup
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# API integration tests (created automatically when missing)
TEST_DATABASE_URL=postgresql+psycopg://followup:followup@localhost:5433/followup_test

# Supabase Auth (API, runtime only). Set the JWT secret OR the JWKS URL.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Agent model (API, runtime only). "provider:model" with provider anthropic, openai,
# deepseek, kimi or mimo. Leave empty in development to use the fake model.
LLM_MODEL=
# Set only the key of the provider in LLM_MODEL (Kimi uses MOONSHOT_API_KEY).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MIMO_API_KEY=
# Optional endpoint override (e.g. Moonshot China or MiMo Token Plan).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
SIMULATOR_DAILY_LIMIT=300

# LangSmith tracing (API, runtime only, optional everywhere). Off unless set to true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Defaults to inmo24x7-dev / inmo24x7-prod by APP_ENV.
LANGSMITH_PROJECT=
# Only for the EU region or self-hosted LangSmith.
LANGSMITH_ENDPOINT=
# Fraction of turns traced, 0 to 1 (e.g. 0.2 in production).
LANGSMITH_TRACING_SAMPLING_RATE=
# Masks emails, phone numbers and DNIs before anything is sent. Keep true.
LANGSMITH_REDACT_PII=true
# Project page in the LangSmith UI (.../o/<org>/projects/p/<project-id>) for "Ver traza".
LANGSMITH_UI_URL=
# Production can drop all inputs/outputs from traces and keep only structure and timing:
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Frontend Supabase client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Frontend build-time API URL
VITE_API_URL=http://localhost:8001
# Panel origin for sample property links opened from the backoffice
VITE_PANEL_URL=http://localhost:5173

# Build metadata returned by /health/ready
APP_VERSION=0.1.0
GIT_COMMIT=unknown
BUILD_DATE=unknown

# Meta variables are added in later milestones.
