# Application
APP_ENV=development

# Local Postgres used by Docker Compose
POSTGRES_USER=followup
POSTGRES_PASSWORD=followup
POSTGRES_DB=followup

# API and migrations
DATABASE_URL=postgresql+psycopg://followup:followup@localhost:5433/followup
# inmo24x7's panels. Cuentas Claras reads its own (CUENTAS_CLARAS_ prefix, below).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# API integration tests (created automatically when missing)
TEST_DATABASE_URL=postgresql+psycopg://followup:followup@localhost:5433/followup_test

# Sign-in. "dev" accepts `dev:<email>` tokens and needs no Supabase project (local only:
# APP_ENV=production refuses it). "supabase" verifies Supabase JWTs with the values below.
AUTH_MODE=dev

# Supabase Auth (API, runtime only, AUTH_MODE=supabase). Set the JWT secret OR the JWKS URL.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# The service-role key: the APIs create invited users and set passwords (server-side only).
SUPABASE_SERVICE_ROLE_KEY=

# Agent model (API, runtime only). "provider:model" with provider anthropic, openai,
# deepseek, kimi or mimo. Leave empty in development to use the fake model.
LLM_MODEL=
# Set only the key of the provider in LLM_MODEL (Kimi uses MOONSHOT_API_KEY).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MIMO_API_KEY=
# Optional endpoint override (e.g. Moonshot China or MiMo Token Plan).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
SIMULATOR_DAILY_LIMIT=300

# LangSmith tracing (API, runtime only, optional everywhere). Off unless set to true.
# Optional settings (project, endpoint, sampling, PII masking, "Ver traza" link) are in the
# README environment table.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# The LangSmith agent the turns go to (set both). Environment: local, development, staging
# or production.
LANGSMITH_AGENT_ID=followup-agent-24x7
LANGSMITH_AGENT_ENVIRONMENT=local

# WhatsApp Cloud API (API and worker, runtime only). The values below are for local
# development only: production refuses them. "log" sends nothing to Meta (path A in the README).
WHATSAPP_SENDER=log
META_APP_SECRET=dev-app-secret
WHATSAPP_VERIFY_TOKEN=dev-verify-token
# Encrypts the stored access tokens (base64, 32 bytes). Generate one per environment:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=aW5tbzI0eDctZGV2LW9ubHktdG9rZW4ta2V5LTAwMDE=
META_GRAPH_API_VERSION=v26.0
# Embedded Signup (customers connect their own number). Empty locally: the button is disabled
# and admins connect numbers by hand in the backoffice. Required in production.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Seconds the worker waits for more messages before answering a burst.
INBOUND_DEBOUNCE_SECONDS=3
WORKER_CONCURRENCY=4

# New-lead emails: Mailpit from docker compose (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=inmo24x7 <avisos@inmo24x7.local>
# Links in emails and WhatsApp messages (sample property pages) point here.
PANEL_URL=http://localhost:5173
# Shown on the suspended-account screen.
SUPPORT_EMAIL=soporte@inmo24x7.local

# Frontend sign-in: "dev" shows the "Modo desarrollo" box; production builds refuse it.
VITE_AUTH_MODE=dev
# Frontend Supabase client (VITE_AUTH_MODE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Frontend build-time API URL
VITE_API_URL=http://localhost:8001
# Panel origin for sample property links opened from the backoffice
VITE_PANEL_URL=http://localhost:5173
# Embedded Signup in the panel (build time; the same values as META_APP_ID and
# META_EMBEDDED_SIGNUP_CONFIG_ID). The Facebook SDK only runs on HTTPS pages.
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v26.0

# Cuentas Claras (API 8002, panel 5175, backoffice 5176). These are its defaults: the same
# database, Supabase and SMTP settings as above; only the CORS origins, the panel URL and its
# panels' API URL are its own.
CUENTAS_CLARAS_CORS_ORIGINS=http://localhost:5175,http://localhost:5176
CUENTAS_CLARAS_PANEL_URL=http://localhost:5175
VITE_CUENTAS_CLARAS_API_URL=http://localhost:8002
# Cuentas Claras's own Meta app (empty locally: the seed's log-sender number needs none, and
# scripts/simulate_whatsapp.py --product cuentas-claras signs with dev-app-secret).
CUENTAS_CLARAS_META_APP_ID=
CUENTAS_CLARAS_META_APP_SECRET=dev-app-secret
CUENTAS_CLARAS_WHATSAPP_VERIFY_TOKEN=dev-verify-token
CUENTAS_CLARAS_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_CUENTAS_CLARAS_META_APP_ID=
VITE_CUENTAS_CLARAS_META_EMBEDDED_SIGNUP_CONFIG_ID=

# Build metadata returned by /health/ready
APP_VERSION=0.1.0
GIT_COMMIT=unknown
BUILD_DATE=unknown


# --- Monitoring (all optional; empty = off) -----------------------------------------------
# Errors to Sentry from the API and the worker (runtime). Leave empty locally unless you are
# trying it: any DSN works, e.g. a test project's.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# The backoffice's Errores page reads open issues (read-only internal integration token).
SENTRY_API_TOKEN=
SENTRY_ORG=
# area=slug for api (API and worker), panel and backoffice.
SENTRY_PROJECTS=
SENTRY_API_URL=https://sentry.io
# The panels' errors (build time, per panel; CI sets it from SENTRY_DSN_PANEL /
# SENTRY_DSN_BACKOFFICE). VITE_RELEASE is the commit in builds.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# The backoffice's "Ver logs" links into Grafana Explore. Locally:
# `uv run --all-packages python scripts/dev.py --observability` → http://localhost:3000.
GRAFANA_URL=
LOKI_DATASOURCE=loki
# Monthly LLM cost per business (USD) that emails SUPPORT_EMAIL; empty = off.
LLM_MONTHLY_COST_ALERT_USD=
