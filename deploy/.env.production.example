# inmo24x7 production environment. Copy to /opt/inmo24x7/.env.production on the VM,
# fill every value, and `chmod 600` it. Never commit the real file. docs/go-live.md says where
# each value comes from. Placeholders in <angle brackets>.

# --- Deploy ------------------------------------------------------------------------------------
# GHCR prefix of the images CI builds (lowercase owner/repository).
IMAGE_PREFIX=ghcr.io/<owner>/<repository>
# The three public hosts (DNS A records to the VM) and the Let's Encrypt contact.
APP_DOMAIN=app.<domain>
ADMIN_DOMAIN=admin.<domain>
API_DOMAIN=api.<domain>
ACME_EMAIL=<ops@domain>

# --- App ---------------------------------------------------------------------------------------
APP_ENV=production
# Supabase → Connect → Session pooler (port 5432, IPv4 on every plan). Never the transaction
# pooler on 6543: the API refuses it (no prepared statements there).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Alternative only with IPv6 on the VM or Supabase's IPv4 add-on (direct connection):
# DATABASE_URL=postgresql+psycopg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Connections per process. The session pooler gives each one a server connection. Each of
# the API and the worker also keeps one more for LLM usage rows (written outside the turn):
# API 6+1 + worker 5+1 + one-offs (migration, backup) 2 = 15, the smallest plan's pool.
API_DB_POOL_SIZE=5
API_DB_MAX_OVERFLOW=1
# Must be at least WORKER_CONCURRENCY + 1.
WORKER_DB_POOL_SIZE=5
WORKER_CONCURRENCY=4
CORS_ORIGINS=https://app.<domain>,https://admin.<domain>
# The panel's URL, for links in emails and on WhatsApp.
PANEL_URL=https://app.<domain>
SUPPORT_EMAIL=<soporte@domain>

# --- Auth (Supabase) ---------------------------------------------------------------------------
AUTH_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Asymmetric signing keys (Supabase → Authentication → JWT keys).
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# The service-role (secret) key: the APIs create invited users and set their passwords through
# Supabase Auth's admin API. Server-side only; never put it in a panel build.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# --- Agent model -------------------------------------------------------------------------------
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=<key>
# Optional tracing (inputs and outputs are redacted of PII).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=followup-agent-24x7
LANGSMITH_AGENT_ENVIRONMENT=production
LANGSMITH_TRACING_SAMPLING_RATE=0.25
LANGSMITH_REDACT_PII=true

# --- WhatsApp (Meta) ---------------------------------------------------------------------------
WHATSAPP_SENDER=cloud
# Meta app → App settings → Basic: app id (public) and app secret (verifies webhooks).
META_APP_ID=<app-id>
META_APP_SECRET=<app-secret>
# Facebook Login for Business → the Embedded Signup configuration id.
META_EMBEDDED_SIGNUP_CONFIG_ID=<config-id>
# Any long random string; type the same one in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=<random-string>
META_GRAPH_API_VERSION=v26.0
WHATSAPP_DEFAULT_TEMPLATE=hello_world
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_US
# Encrypts the stored WhatsApp tokens. Generate once and keep a copy in your password
# manager: without it the stored tokens cannot be read.
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=<base64-32-bytes>
INBOUND_DEBOUNCE_SECONDS=3

# --- Email (new-lead emails, reconnect links) ---------------------------------------------------
SMTP_HOST=<smtp.provider.com>
SMTP_PORT=587
SMTP_USERNAME=<user>
SMTP_PASSWORD=<password>
SMTP_STARTTLS=true
EMAIL_FROM=inmo24x7 <avisos@<domain>>

# --- Backups (deploy/backup) --------------------------------------------------------------------
# The age PUBLIC key backups are encrypted to. The private key never goes on the VM.
BACKUP_AGE_RECIPIENT=age1<public-key>
# rclone remote and path. Oracle Object Storage through its S3-compatible API:
BACKUP_REMOTE=:s3,provider=Other,endpoint=https://<namespace>.compat.objectstorage.sa-saopaulo-1.oraclecloud.com,region=sa-saopaulo-1,force_path_style=true:<bucket>/inmo24x7
# Customer secret key pair (Oracle → User settings → Customer secret keys).
RCLONE_S3_ACCESS_KEY_ID=<access-key>
RCLONE_S3_SECRET_ACCESS_KEY=<secret-key>
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# --- Cuentas Claras (off until its go-live) ----------------------------------------------------
# Same VM, database and Supabase project. Add "cuentas-claras" to COMPOSE_PROFILES below to
# start cc-api, cc-worker, cc-web and cc-backoffice and publish these three hosts.
CC_APP_DOMAIN=cuentasclaras.<domain>
CC_ADMIN_DOMAIN=cuentasclaras-admin.<domain>
CC_API_DOMAIN=cuentasclaras-api.<domain>
CUENTAS_CLARAS_CORS_ORIGINS=https://cuentasclaras.<domain>,https://cuentasclaras-admin.<domain>
CUENTAS_CLARAS_PANEL_URL=https://cuentasclaras.<domain>
CUENTAS_CLARAS_EMAIL_FROM=Cuentas Claras <avisos@<domain>>
# Its API's and worker's Sentry DSN (empty = off).
CUENTAS_CLARAS_SENTRY_DSN=
# Connections: cc-api 3+1+1 + cc-worker 2+1 (each keeps one for usage rows) come on top of
# the 15 above: a bigger Supabase plan, or smaller inmo24x7 pools.
CC_API_DB_POOL_SIZE=3
CC_API_DB_MAX_OVERFLOW=1
CC_WORKER_DB_POOL_SIZE=2

# --- Monitoring (docs/go-live.md, "Monitoring"). Everything here is optional. -----------------
# Errors to Sentry (empty = off). One DSN for the API and the worker; the panels' DSNs are
# build-time CI variables (SENTRY_DSN_PANEL, SENTRY_DSN_BACKOFFICE).
SENTRY_DSN=
# Performance tracing: 0 = off (errors only).
SENTRY_TRACES_SAMPLE_RATE=0
# The panels send errors to this host: Caddy allows it in the CSP (empty = nothing allowed).
# From a DSN https://<key>@o123.ingest.us.sentry.io/456 it is https://o123.ingest.us.sentry.io
SENTRY_INGEST_HOST=
# The backoffice's Errores page reads open issues with a read-only token (Sentry → Settings →
# Custom Integrations → Internal integration, Issues & Events: Read).
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECTS=api=inmo24x7-api,panel=inmo24x7-panel,backoffice=inmo24x7-backoffice
# https://de.sentry.io for an organization in the EU region.
SENTRY_API_URL=https://sentry.io

# Logs: Loki + Alloy + Grafana on this VM (about 1 GB of RAM; deploy/observability.md).
# Remove "observability" to run without them on a small VM. "observability,cuentas-claras"
# also runs Cuentas Claras.
COMPOSE_PROFILES=observability
LOKI_RETENTION_DAYS=14
# Grafana's admin password (required with the profile on). Change it again at first login.
GRAFANA_ADMIN_PASSWORD=<long-random-password>
# Publish Grafana at https://grafana.<domain> (a DNS A record to the VM). Empty: not
# published; use an SSH tunnel to 127.0.0.1:3000.
GRAFANA_DOMAIN=grafana.<domain>
# Space-separated IPs/CIDRs allowed to reach GRAFANA_DOMAIN (empty = anyone; Grafana's login
# still applies), e.g. "203.0.113.7/32 2001:db8::/48".
GRAFANA_ALLOWED_IPS=
# Plain address for Grafana's alert emails (to SUPPORT_EMAIL, through the SMTP above).
ALERTS_EMAIL_FROM=alertas@<domain>
# The backoffice's "Ver logs" links (empty = hidden). LOKI_DATASOURCE is the provisioned uid.
GRAFANA_URL=https://grafana.<domain>
LOKI_DATASOURCE=loki

# --- LLM cost --------------------------------------------------------------------------------
# Email SUPPORT_EMAIL once a month when a business's LLM cost passes this many USD (empty = off).
LLM_MONTHLY_COST_ALERT_USD=
