      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({environment=\"$environment\", service=\"api\"} | json | message=\"request_completed\" | status_code >= 500 [$__auto]))",
          "legendFormat": "5xx",
          "queryType": "range"
        }
