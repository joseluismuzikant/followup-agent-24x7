# Cuentas Claras's hosts (lib.sh mounts this file only when COMPOSE_PROFILES has
# cuentas-claras): CC_APP_DOMAIN (panel), CC_ADMIN_DOMAIN (backoffice) and CC_API_DOMAIN,
# for example cuentasclaras.<domain>, cuentasclaras-admin.<domain>, cuentasclaras-api.<domain>.
# The snippets come from the main Caddyfile.

{$CC_API_DOMAIN} {
	import security_headers
	import access_log
	header {
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}
	encode zstd gzip
	# Invoice imports go up to 5 MB plus the multipart overhead.
	request_body {
		max_size 6MB
	}
	reverse_proxy cc-api:8002
}

{$CC_APP_DOMAIN} {
	import security_headers
	import access_log
	import spa_cache
	header {
		# Embedded Signup, as in inmo24x7's panel: the Facebook SDK loads from
		# connect.facebook.net and opens its popup and iframes on facebook.com.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://connect.facebook.net; frame-src https://*.facebook.com; connect-src 'self' https://{$CC_API_DOMAIN} {$SUPABASE_URL} {$SENTRY_INGEST_HOST} https://*.facebook.com https://graph.facebook.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}
	encode zstd gzip
	reverse_proxy cc-web:80
}

{$CC_ADMIN_DOMAIN} {
	import security_headers
	import access_log
	import spa_cache
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' https://{$CC_API_DOMAIN} {$SUPABASE_URL} {$SENTRY_INGEST_HOST}; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
	}
	encode zstd gzip
	reverse_proxy cc-backoffice:80
}
